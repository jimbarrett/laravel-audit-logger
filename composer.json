{
    "name": "jimbarrett/laravel-audit-logger",
    "description": "A Laravel package for comprehensive audit logging with multi-tenancy support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jim Barrett",
            "email": "jim@jim.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JimBarrett\\LaravelAuditLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JimBarrett\\LaravelAuditLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JimBarrett\\LaravelAuditLogger\\AuditLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
